      "sql": "WITH ctx AS (SELECT e.loop_run_id,e.created_at,e.metadata,ROW_NUMBER() OVER (PARTITION BY e.loop_run_id ORDER BY e.created_at DESC,e.rowid DESC) ord FROM loop_events e WHERE e.event_type='assignment_context' AND julianday(e.created_at)>=julianday(?)), eligible AS (SELECT e.loop_run_id,r.goal_id,r.loop_name,r.status run_status,s.status proposal_status,e.metadata,\nCASE WHEN json_extract(e.metadata,'$.memory_holdout')=1 THEN 'holdout' ELSE 'rules' END arm,\nEXISTS (SELECT 1 FROM judgments oa WHERE oa.judgment = 'outcome_attribution' AND oa.decision IN ('reviewer_failure', 'environment_failure')\n    AND ((oa.subject_type = 'loop_run' AND oa.subject_id = e.loop_run_id)\n      OR (oa.subject_type = 'self_improvement' AND EXISTS (SELECT 1 FROM loop_runs oar JOIN goals oag ON oag.id = oar.goal_id\n        WHERE oar.id = e.loop_run_id AND oag.improvement_id = oa.subject_id AND oar.created_at <= oa.created_at)))) non_maker,\nCASE WHEN NOT EXISTS (SELECT 1 FROM worker_leases fl\n  WHERE fl.loop_run_id = e.loop_run_id AND json_extract(fl.metadata, '$.runtime_fallback') IS NOT NULL) THEN 0 ELSE 1 END fallback\nFROM ctx e JOIN loop_runs r ON r.id=e.loop_run_id JOIN goals g ON g.id=r.goal_id JOIN self_improvements s ON s.id=g.improvement_id\nWHERE e.ord=1 AND (json_extract(e.metadata,'$.memory_holdout')=1 OR json_array_length(json_extract(e.metadata,'$.rule_ids'))>0)) SELECT arm,proposal_status,non_maker,fallback,COUNT(*) runs,COUNT(DISTINCT goal_id) goals FROM eligible GROUP BY 1,2,3,4",
