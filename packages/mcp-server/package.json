{
  "name": "@djimitflo/mcp-server",
  "version": "0.5.8",
  "private": true,
  "description": "DjimitFlo MCP Server — exposes loop orchestration, goal management, and agent capabilities via Model Context Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "djimitflo-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@djimitflo/shared": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}
