    {
      "id": "claim_fd51d89590e24ad68e25523a75e62d3c",
      "statement": "Restore is a two-phase flow: stageRestore requires the literal body confirm='RESTORE', re-runs full validation, first creates a safety backup of the current database (audited backup.pre_restore_created at HIGH risk), copies the extracted djimitflo.sqlite to <dbPath>.restore-pending, and writes a restore-pending.json marker into the backup directory recording stagedDbPath, targetDbPath, safetyBackupFilename, timestamp, actor identity, and restoreFrom; it returns restartRequired: true without touching the active database.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/__tests__/backup.test.ts#L158-L222",
          "version": "repo-lines-v1:sha256:355314201e98350ebb2660f519bc7bcbfd1153e36e32cd315c16f5339600a728:"
