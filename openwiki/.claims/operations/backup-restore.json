    {
      "id": "claim_2c10c44837204bd8b4faee9eb6251405",
      "statement": "validateBackup extracts archives through a hardened extractor that skips symlink/hardlink entries, absolute/traversal/backslash entry names, duplicates, and any entry outside the three expected names, writing only to join(targetDir, basename(name)); it then verifies checksums.sha256 against freshly computed SHA-256 hashes, requires manifest.json to be parseable and at most 64 KiB (MAX_MANIFEST_SIZE), cross-checks the manifest's embedded databaseSha256, rejects backups whose appVersion major digit differs from the running app's, and opens the extracted database read-only to require PRAGMA integrity_check to return exactly 'ok'.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/services/backup-service.ts#L187-L301",
          "version": "repo-lines-v1:sha256:078478b30ca15f9d3f5d26165a4320cf1c285f91432dcbe31a818597e193dd4d:"
