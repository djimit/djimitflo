    {
      "id": "claim_a60e343d6b9643699c5d03d53f7d3d1f",
      "statement": "The polling gateway starts only in operator-capable runtime profiles (operator or autonomous, never the default api profile) and only when TELEGRAM_BOTS_CONFIG is set; the JSON array's per-bot allowedUsers/userMap fall back to the TELEGRAM_ALLOWED_USERS/TELEGRAM_USER_MAP parsers shared with the webhook route, TelegramGatewayService is dynamically imported from @djimitflo/telegram, and its ops are a TelegramApiService pointed at the loopback base http://127.0.0.1:${PORT}/api. Missing config or init failure logs and continues without blocking boot.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/config/runtime-profile.ts#L13-L15",
          "version": "repo-lines-v1:sha256:f95a58b45eb8b3584a3264c56f7d2cde100faa68ab7793b261b8b3c688cfc350:"
