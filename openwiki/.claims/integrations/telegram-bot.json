  "claims": [
    {
      "id": "claim_6cf598aba30145d48fd3af3a2725a6dd",
      "statement": "Djimitflo has two independent Telegram surfaces with no shared transport code: the @djimitflo/telegram long-polling gateway (TelegramGatewayService in packages/telegram) and the single-bot webhook route at /api/telegram (createTelegramRoutes with TelegramBotService); both resolve Telegram senders to DjimFlo actors through an allowedUsers list plus an explicit userMap before any command runs.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/routes/telegram.ts#L47-L59",
          "version": "repo-lines-v1:sha256:beda41e87fd8582b041493886f21ff8c29d38c419099b7ddecdfbee266c151a9:"
        },
        {
