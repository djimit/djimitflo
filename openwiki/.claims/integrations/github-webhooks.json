    {
      "id": "claim_17defd1293ac4151b7b92a058063261b",
      "statement": "createGitHubWebhookRoutes is mounted at /github/webhook before express.json() in packages/server/src/index.ts because the X-Hub-Signature-256 HMAC authenticates exact wire bytes; the router applies a 60 req/min rate limiter then express.raw with a 256kb cap so req.body stays a Buffer, and the handler rejects non-Buffer bodies with 400 GITHUB_WEBHOOK_RAW_BODY_REQUIRED and returns 503 GITHUB_WEBHOOK_UNCONFIGURED when GITHUB_WEBHOOK_SECRET is unset.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/index.ts#L134-L137",
          "version": "repo-lines-v1:sha256:13d76c5ed0e4ca635625eb69f1c744c9f3af9ed7e44d730b01450e657aedbc8e:"
