    {
      "id": "claim_2e1fef669caf444eb2708e43ede573fa",
      "statement": "Express registration order is load-bearing in the mount table: /swarms/spawns (requireAuthOrSpawnToken) and /swarm-v2/social-runtime (empty middleware, signed runtime callbacks, no user JWT) must precede /swarms and /swarm-v2, and diff routes mount at '/' with no mount-level guard because each handler authenticates itself and a '/' guard would intercept later public routes such as the Telegram webhook.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/routes/index.ts#L180-L195",
          "version": "repo-lines-v1:sha256:cc12f2424616d50b7f6d07155d746d595ba86e93e93a0c9017dfaa984b7dbe7c:"
        }
      ]
