    {
      "id": "claim_7552e91e2f1544059c5c7927a437bbc2",
      "statement": "decideApproval() wraps its status transition in an immediate transaction with a compare-and-swap UPDATE ... WHERE id = ? AND status = 'pending', rejects non-boolean decisions with INVALID_APPROVAL_DECISION, throws 'Approval already processed' for a non-pending row, and persists decided_by, decided_at, and decision_reason alongside the legacy approved_by/denied_at fields with the granted/denied audit record in the same transaction.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/__tests__/approval-atomicity.test.ts#L125-L133",
          "version": "repo-lines-v1:sha256:533253d2dd18ed4fddcda3f029e6080585a4f0ad4a06019eecc2e15266aa3ad8:"
