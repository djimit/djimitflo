    {
      "id": "claim_3fde79b076b04726b78d7296949ea00c",
      "statement": "GovernanceGateService is default-off (GOVERNANCE_GATE_ENABLED=true arms it), looks up OpenMythos benchmark evidence by task agent_id then nightly:<model> from GOVERNANCE_GATE_MODEL_MAP then metadata subject_model, returns allow when no evidence exists, and when the latest score is below the floor returns require_approval with a trend and optionally flagRetirement after three consecutive below-floor declining runs — it only ever tightens allow to require_approval and never loosens a deny or approval outcome.",
      "evidence": [
        {
