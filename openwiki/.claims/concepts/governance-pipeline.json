        {
          "resource": "repo://packages/server/src/execution/execution-engine.ts#L243-L340",
          "version": "repo-lines-v1:sha256:f8b1db12261d62cb0211812769c16cf29fc020ced76a0aa2f7f9f62f981e0ce0:"
