    {
      "id": "claim_b9a9e939721842419803e1af09fc9f11",
      "statement": "refreshSession() de-duplicates concurrent refresh calls behind a single in-flight promise and, when the Web Locks API is available, serializes the actual refresh across browser tabs via navigator.locks, re-checking a sessionEpoch counter and loggedOut flag to abort stale work and a sameSessionScope check on JWT sub/sid/organization_id claims before reusing a token set by another tab.",
      "evidence": [
        {
          "resource": "repo://packages/dashboard/src/lib/auth-store.ts#L35-L43",
