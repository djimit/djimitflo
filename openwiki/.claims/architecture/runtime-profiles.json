    {
      "id": "claim_87dd0ef408de474698e13c5c108f7e24",
      "statement": "resolveRuntimeProfile() resolves DJIMITFLO_RUNTIME_PROFILE (trimmed, lowercased) to one of 'api' | 'operator' | 'autonomous'; an unset variable defaults to 'api', and any invalid value (e.g. 'full-send') logs a warning and falls back to 'api' rather than failing.",
      "evidence": [
        {
          "resource": "repo://packages/server/src/__tests__/runtime-profile.test.ts#L8-L15",
          "version": "repo-lines-v1:sha256:a5c7e35ae22b297d6598813ae42dd17d28880f04026926653bb0386e25ac29ed:"
        },
