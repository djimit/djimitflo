    {
      "id": "claim_d9beb202ae144c3da9cdd9fda8938878",
      "statement": "DjimFlo is explicitly labeled a research prototype and is not production-ready for sensitive data; the README states that adapter registration, rendered screens, and passing unit tests do not establish production readiness.",
      "evidence": [
        {
          "resource": "repo://README.md",
